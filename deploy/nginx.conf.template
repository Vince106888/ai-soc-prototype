worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 512; }
http {
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    client_max_body_size 1000000;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    set_real_ip_from ${AI_SOC_PROXY_SUBNET};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    resolver 127.0.0.11 valid=10s ipv6=off;
    limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=identity:1m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=expensive:1m rate=6r/m;
    limit_req_status 429;
    limit_conn_zone $binary_remote_addr zone=connections:1m;
    server {
        listen 8080;
        limit_conn connections 20;
        location = /gateway-health { access_log off; return 200; }
        location ~ ^/api/v1/auth/(login|callback)$ {
            limit_req zone=identity burst=10 nodelay;
            include /etc/nginx/proxy-public.conf;
        }
        location ~ ^(/api/v1/gmail/(scan|consent)|/api/v1/incidents/[^/]+/explanation)$ {
            limit_req zone=expensive burst=3 nodelay;
            include /etc/nginx/proxy-public.conf;
        }
        location / {
            limit_req zone=general burst=30 nodelay;
            include /etc/nginx/proxy-public.conf;
        }
    }
}
