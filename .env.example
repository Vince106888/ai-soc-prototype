# Required outside local unauthenticated evaluation. Generate a long random value.
AI_SOC_API_KEY=replace-with-a-random-secret

# Local default: sqlite:///data/sentinelsme.db
# Container deployment: postgresql+psycopg://sentinelsme:change-me@db:5432/sentinelsme
AI_SOC_DATABASE_URL=sqlite:///data/sentinelsme.db

# Comma-separated Host headers accepted by the API.
AI_SOC_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Docker Compose only. Replace before starting the stack.
POSTGRES_DB=sentinelsme
POSTGRES_USER=sentinelsme
POSTGRES_PASSWORD=replace-with-a-database-password
