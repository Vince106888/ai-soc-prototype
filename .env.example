# Optional shared key for trusted local mode. This is not user authentication.
AI_SOC_API_KEY=replace-with-a-random-secret

# Local default: sqlite:///data/sentinelsme.db
# Container deployment: postgresql+psycopg://sentinelsme:change-me@db:5432/sentinelsme
AI_SOC_DATABASE_URL=sqlite:///data/sentinelsme.db

# Comma-separated Host headers accepted by the API.
AI_SOC_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Docker Compose only. Replace before starting the stack.
POSTGRES_DB=sentinelsme
POSTGRES_USER=sentinelsme
POSTGRES_PASSWORD=replace-with-a-database-password

# Optional local Gmail trial. Prefer scripts/configure-gmail.ps1 for hidden input.
AI_SOC_GOOGLE_CLIENT_ID=
AI_SOC_GOOGLE_CLIENT_SECRET=
AI_SOC_GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/gmail/callback
# Absolute path outside the repository; keep the key with the encrypted tokens.
AI_SOC_TOKEN_KEY_FILE=

# Invited sign-in is opt-in and currently restricted to a localhost pilot.
AI_SOC_AUTH_MODE=local
AI_SOC_INVITED_EMAILS=
AI_SOC_GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:5173/api/v1/auth/callback

# Optional local-model explanations (Ollama on this computer only; loopback URL enforced).
# Leave as "off" to keep deterministic template explanations.
AI_SOC_EXPLAINER=off
AI_SOC_OLLAMA_URL=http://127.0.0.1:11434
AI_SOC_OLLAMA_MODEL=qwen2.5:3b
AI_SOC_EXPLAINER_TIMEOUT=120
